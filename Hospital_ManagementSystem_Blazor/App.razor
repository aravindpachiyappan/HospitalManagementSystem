@using Hospital_ManagementSystem_Blazor.Pages
@using Microsoft.AspNetCore.Components.Authorization

<CascadingAuthenticationState>

    <Router AppAssembly="@typeof(App).Assembly">

        <Found Context="routeData">

            <AuthorizeRouteView
                RouteData="@routeData"
                DefaultLayout="@typeof(MainLayout)">

                <NotAuthorized>

                    <RedirectToLogin />

                </NotAuthorized>

            </AuthorizeRouteView>

        </Found>
        <NotFound>

        <RedirectToNotFound />
    </NotFound>

    </Router>

</CascadingAuthenticationState>