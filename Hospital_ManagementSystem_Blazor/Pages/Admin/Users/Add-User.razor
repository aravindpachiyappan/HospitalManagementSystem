@page "/add-user"

@using Hospital_ManagementSystem_Blazor.DTOs.UsersDTO
@using System.Net.Http.Json
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudPaper Class="pa-4">

    <div class="d-flex justify-space-between align-center mb-4">

    <MudText Typo="Typo.h4" Class="mb-4">
        Add Users
    </MudText>

    <MudButton Variant="Variant.Filled"
               Color="Color.Error"
               OnClick="ReturnList"
               Class="mb-4">
        Back
    </MudButton>
    </div>

    <MudTextField T="string"
                  Label="User Name"
                  @bind-Value="model.UserName"
                  Required="true"
                  RequiredError="Please select a UserName."
                  Variant="Variant.Outlined"
                  Class="mb-3"/>

    <MudTextField T="string"
                  Label="Email"
                  @bind-Value="model.Email"
                  Required="true"
                  RequiredError="Please select a Email."
                  Variant="Variant.Outlined"
                  Class="mb-3" />

    <MudTextField T="string"
                  Label="Password"
                  @bind-Value="model.Password"
                  InputType="InputType.Password"
                  Variant="Variant.Outlined"
                  Required="true"
                  RequiredError="Please select a Password."
                  Class="mb-3" />

    <MudSelect T="int?"
               Label="Role"
               @bind-Value="model.RoleId"
               Variant="Variant.Outlined"
               Required="true"
               RequiredError="Please select a role."
               Class="mb-4">

        @foreach (var role in roles)
        {
            <MudSelectItem T="int?" Value="@role.RoleId">
                @role.RoleName
            </MudSelectItem>
        }

    </MudSelect>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="CreateUser">
        Save
    </MudButton>
</MudPaper>

@code {

    private AddUsersRequestDTO model = new();
    private List<RoleDTO> roles = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadRoles();
    }

    private async Task LoadRoles()
    {
        try
        {
            var request = new RoleDTO();

            var response = await Http.PostAsJsonAsync("user/role-list", request);

            if (response.IsSuccessStatusCode)
            {
                roles = await response.Content.ReadFromJsonAsync<List<RoleDTO>>() ?? new();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading roles: {ex.Message}", Severity.Error);
        }
    }

    private async Task CreateUser()
    {
        if (model.RoleId == null)
        {
            Snackbar.Add("Please select a role.", Severity.Warning);
            return;
        }

        var response = await Http.PostAsJsonAsync("user/add-user", model);

        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("User created successfully.", Severity.Success);
            model = new AddUsersRequestDTO();
            Navigation.NavigateTo("/user-list");
        }
        else
        {
            Snackbar.Add("Failed to create user.", Severity.Error);
        }
    }

    public void ReturnList()
    {
        Navigation.NavigateTo("/user-list");
    }
}