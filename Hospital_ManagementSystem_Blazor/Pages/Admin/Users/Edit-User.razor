@page "/edit-user/{UserId:int}"

@using Hospital_ManagementSystem_Blazor.DTOs.UsersDTO
@using System.Net.Http.Json
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudPaper Class="pa-4">

    <MudText Typo="Typo.h4" Class="mb-4">
        Edit User
    </MudText>

    <MudButton Variant="Variant.Filled"
               Color="Color.Error"
               OnClick="ReturnList"
               Class="mb-4">
        Back
    </MudButton>

    <MudTextField T="string"
                  Label="User Name"
                  @bind-Value="model.UserName"
                  Required="true"
                  Variant="Variant.Outlined"
                  Class="mb-3"/>

    <MudTextField T="string"
                  Label="Email"
                  @bind-Value="model.Email"
                  Required="true"
                  Variant="Variant.Outlined"
                  Class="mb-3" />

    <MudTextField T="string"
                  Label="Password"
                  @bind-Value="model.Password"
                  InputType="InputType.Password"
                  Variant="Variant.Outlined"
                  Required="true"
                  Class="mb-3" />

    <MudSelect T="int"
               Label="Role"
               @bind-Value="model.RoleId"
               Variant="Variant.Outlined"
               Required="true"
               Class="mb-4">
        @foreach (var role in roles)
        {
            <MudSelectItem T="int" Value="@role.RoleId">@role.RoleName</MudSelectItem>
        }
    </MudSelect>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="UpdateUser">
        Update
    </MudButton>
</MudPaper>

@code {

    [Parameter]
    public int UserId { get; set; }

    private UpdateUserRequestDTO model = new();
    private List<RoleDTO> roles = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadRoles();
        await LoadUserDetails();
    }

    private async Task LoadRoles()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("user/role-list", new { });

            if (response.IsSuccessStatusCode)
            {
                roles = await response.Content.ReadFromJsonAsync<List<RoleDTO>>() ?? new();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading roles: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadUserDetails()
    {
        try
        {
            // Fetch single user from api/user/get-user/{id}
            var response = await Http.PostAsJsonAsync($"user/get-user/{UserId}", new { });

        if (response.IsSuccessStatusCode)
            {
               var details = await response.Content.ReadFromJsonAsync<UserDetailResponse>();

    if (details != null)
    {
        model.UserId = details.UserId;
        model.UserName = details.UserName;
        model.Email = details.Email;
        model.Password = details.Password;
        model.RoleId = details.RoleId;
    }
}
            else
            {
                Snackbar.Add("Failed to load user details.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading user: {ex.Message}", Severity.Error);
        }
    }

    private async Task UpdateUser()
    {
        if (model.RoleId == 0)
        {
            Snackbar.Add("Please select a role.", Severity.Warning);
            return;
        }

        var response = await Http.PostAsJsonAsync("user/update-user", model);

        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add("User updated successfully.", Severity.Success);
            Navigation.NavigateTo("/user-list");
        }
        else
        {
            var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            Snackbar.Add(error?.Message ?? "Failed to update user.", Severity.Error);
        }
    }

    public void ReturnList()
    {
        Navigation.NavigateTo("/user-list");
    }

    public class ErrorResponse
    {
        public string Message { get; set; } = string.Empty;
    }
}
